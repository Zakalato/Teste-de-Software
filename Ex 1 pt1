package fonts;

public class OperadorAritmetrico {

	private int valor1;
	private int valor2;
	private int opcao;
	
	public OperadorAritmetrico(int vl1, int vl2) {
		valor1 = vl1;
		valor2 = vl2;
		
	}
	public int getValor2() {
		return valor2;
	}
	
	public int getValor1() {
		return valor1;
	}
	
	public int somar() {
		return valor1 + valor2;
	}
	
	public int subtrair() {
		return valor1 - valor2;
	}
	
	public int dividir() {
		return valor1 / valor2;
	}
	
	public int multiplicar() {
		return valor1 * valor2;
	}
	
	public boolean ehPar (int valor) {
		return valor % 2 == 0;
	}
	
}
